{
  "name": "360bizhealth-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "serve": "node scripts/serve.mjs",
    "preview": "npm run build && node scripts/serve.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "admin:add": "node scripts/add-admin.mjs",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:api": "vitest run tests/api",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run build && npm run test:e2e && node scripts/check-bundle.mjs",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^4.3.1",
    "embedded-postgres": "17.10.0-beta.17",
    "vite": "^5.4.8",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": "22.x"
  }
}
