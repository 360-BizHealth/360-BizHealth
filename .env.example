# ---------------------------------------------------------------------------
# 360 Biz Health: environment variables
# Copy to .env for local development. In production set these in
# Vercel → Project → Settings → Environment Variables (never commit real values).
# Only variables prefixed VITE_ are visible to browser code; everything else is
# server-only and is read by the /api functions.
# ---------------------------------------------------------------------------

# Public site URL (no trailing slash). Used for origin checks and links in e-mails.
SITE_URL=https://www.360bizhealth.com
# Same value, baked into the frontend build for canonical URLs, sitemap and Open Graph.
VITE_SITE_URL=https://www.360bizhealth.com
# Optional: extra origins allowed to submit the form (comma-separated), e.g. a staging domain.
ALLOWED_ORIGINS=

# --- Database (Supabase PostgreSQL) -----------------------------------------
# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (port 6543).
DATABASE_URL="postgresql://postgres:YOUR_ACTUAL_PASSWORD@db.iahfnaezomwpkwkcwgcs.supabase.co:5432/postgres"
# require (default, encrypted) | verify (encrypted + CA check, set DATABASE_CA_CERT) | disable (local only)
DATABASE_SSL=require
DATABASE_CA_CERT=
# Optional, for `npm run db:migrate` / `npm run admin:add` only: the "Session pooler" or direct connection string.
MIGRATION_DATABASE_URL=

# --- Administrator sign-in (Supabase Auth) ----------------------------------
# Supabase → Project Settings → API. The anon/publishable key is used server-side only here.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# --- Lead notification e-mail (Resend) --------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Must use a domain verified in Resend, e.g. "360 Biz Health <leads@360bizhealth.com>"
EMAIL_FROM=360 Biz Health Website <leads@360bizhealth.com>
# Who receives new-lead alerts (comma-separated)
LEAD_NOTIFICATION_TO=contact@360bizhealth.com

# --- Security ---------------------------------------------------------------
# Long random string used to hash visitor IP addresses for rate limiting. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=change-me-to-a-long-random-string
# Long random string; Vercel Cron sends it as a Bearer token to the retry job.
CRON_SECRET=change-me-to-another-long-random-string

# --- Optional: Cloudflare Turnstile CAPTCHA ----------------------------------
# Leave both empty to rely on the honeypot, timing check and rate limits only.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Local development only --------------------------------------------------
# Lets the admin session cookie work over plain http://localhost. Ignored in production.
ALLOW_INSECURE_COOKIES=true
ADMIN_SESSION_SECRET="e93174a13cd7ab6cd68e8a7487687ff5323c55894a6f5059c1fcfa0076523f7a"