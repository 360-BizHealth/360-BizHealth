{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/resources/blogs-news/:slug",
      "destination": "/blog/:slug",
      "statusCode": 301
    },
    {
      "source": "/resources/blogs-news",
      "destination": "/blog",
      "statusCode": 301
    },
    {
      "source": "/privacy",
      "destination": "/privacy-policy",
      "statusCode": 301
    },
    {
      "source": "/terms",
      "destination": "/terms-and-conditions",
      "statusCode": 301
    },
    {
      "source": "/index",
      "destination": "/",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?_vercel_path=:path*"
    },
    {
      "source": "/blog",
      "destination": "/api?_vercel_path=v1/blog-page"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api?_vercel_path=v1/blog-page&slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api?_vercel_path=v1/sitemap"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-N9v3EnPaUyp6HvI/g75KoK11mUw7quk1fPSwEhREnaU=' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 15,
      "includeFiles": "dist-ssr/**"
    }
  },
  "crons": [
    {
      "path": "/api/v1/cron/retry-notifications",
      "schedule": "0 4 * * *"
    }
  ]
}
